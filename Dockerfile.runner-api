FROM golang:1.24.12-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/runner-api ./cmd/runner-api

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/runner-api /runner-api
USER nonroot:nonroot
ENTRYPOINT ["/runner-api"]
