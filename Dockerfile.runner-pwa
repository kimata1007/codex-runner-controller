FROM node:22.23.5-bookworm-slim AS assets
WORKDIR /build
RUN npm install --no-audit --no-fund --save-exact marked@15.0.12 dompurify@3.3.3 @highlightjs/cdn-assets@11.11.1 mermaid@11.12.0 katex@0.16.28 chart.js@4.5.1 \
 && mkdir -p /vendor/katex \
 && cp node_modules/marked/lib/marked.umd.js /vendor/marked.js \
 && cp node_modules/dompurify/dist/purify.min.js /vendor/purify.js \
 && cp node_modules/@highlightjs/cdn-assets/highlight.min.js /vendor/highlight.js \
 && cp node_modules/@highlightjs/cdn-assets/styles/github.min.css /vendor/highlight.css \
 && cp node_modules/mermaid/dist/mermaid.min.js /vendor/mermaid.js \
 && cp -r node_modules/katex/dist/. /vendor/katex/ \
 && cp node_modules/chart.js/dist/chart.umd.js /vendor/chart.js

FROM nginx:1.30.6-alpine3.24
COPY web/ /usr/share/nginx/html/
COPY config/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=assets /vendor/ /usr/share/nginx/html/vendor/
