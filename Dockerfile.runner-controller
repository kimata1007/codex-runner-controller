FROM golang:1.24.12-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/runner-controller ./cmd/runner-controller

FROM gcr.io/distroless/static-debian12:nonroot
COPY --from=build /out/runner-controller /runner-controller
USER 65532:65532
ENTRYPOINT ["/runner-controller"]
