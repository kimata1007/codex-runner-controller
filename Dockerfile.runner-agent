FROM golang:1.24.12-bookworm AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags='-s -w' -o /out/runner-agent ./cmd/runner-agent

FROM node:22.23.5-bookworm-slim
ARG CODEX_CLI_VERSION
WORKDIR /app
RUN apt-get update \
  && apt-get install --no-install-recommends --yes git ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN test -n "$CODEX_CLI_VERSION" \
  && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
  && npm cache clean --force
COPY --from=build /out/runner-agent /runner-agent
COPY scripts/runner-agent-entrypoint.sh /runner-agent-entrypoint
RUN useradd --create-home --uid 10001 --user-group codex \
  && mkdir -p /var/lib/codex \
  && chmod 0755 /runner-agent-entrypoint \
  && chown -R codex:codex /var/lib/codex /app
USER 10001:10001
ENV CODEX_HOME=/var/lib/codex
ENTRYPOINT ["/runner-agent-entrypoint"]
